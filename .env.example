# SQLite database path (default: file:./data/sqlite.db)
DATABASE_URL=file:./data/sqlite.db

# Allowed browser origin for CORS (default: http://localhost:4200)
CORS_ORIGIN=http://localhost:4200

# JWT (required)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Initial super user (required on first boot if no super exists yet)
SUPER_EMAIL=admin@example.com
SUPER_PASSWORD=change-me
